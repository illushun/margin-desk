{
  "name": "marketplace-calculator",
  "version": "1.0.0",
  "description": "Marketplace pricing calculator -- eBay, Amazon, B&Q and custom fees",
  "scripts": {
    "build": "npx esbuild src/ui/app.ts --bundle --outfile=dist/app.js --target=es2020",
